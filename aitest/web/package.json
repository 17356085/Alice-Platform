{
  "name": "tlo-platform",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "TLO — Testing Lifecycle Orchestrator (React 18)",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "electron:dev": "vite & sleep 3 && electron electron/main.js",
    "electron:build": "vite build && electron-builder",
    "electron:win": "vite build && electron-builder --win",
    "electron:mac": "vite build && electron-builder --mac",
    "electron:linux": "vite build && electron-builder --linux"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.10",
    "@xterm/addon-serialize": "^0.13",
    "@xterm/addon-web-links": "^0.11",
    "@xterm/xterm": "^5.5",
    "class-variance-authority": "^0.7",
    "clsx": "^2.1",
    "i18next": "^23.14.0",
    "lucide-react": "^0.441.0",
    "marked": "^18.0.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^15.0.0",
    "react-router-dom": "^6.26.0",
    "tailwind-merge": "^2.5",
    "zod": "^3.23",
    "zustand": "^4.5.4"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4",
    "postcss": "^8.4",
    "tailwindcss": "^3.4",
    "typescript": "^5.5",
    "vite": "^5.4",
    "vitest": "^2.1",
    "@testing-library/react": "^16.0",
    "@testing-library/jest-dom": "^6.5",
    "jsdom": "^25.0"
  }
}
